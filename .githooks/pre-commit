#!/usr/bin/env bash
# Stops a commit that adds a secret. Turn it on once per computer:  git config core.hooksPath .githooks
# Uses gitleaks when installed (https://github.com/gitleaks/gitleaks), otherwise a simple pattern check.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner -c .gitleaks.toml || { echo "Commit stopped: gitleaks found a secret (see above)."; exit 1; }
  exit 0
fi
RE='sb_secret_[A-Za-z0-9_-]{8}|"role"[[:space:]]*:[[:space:]]*"service_role"|-----BEGIN [A-Z ]*PRIVATE KEY-----|postgres(ql)?://[^[:space:]]*:[^@[:space:]]{6,}@|gh[pousr]_[A-Za-z0-9]{20,}|VAPID_PRIVATE[[:space:]]*[:=]'
if git diff --cached -U0 --no-color | grep -E '^\+' | grep -v 'YOUR-DB-PASSWORD' | grep -qE "$RE"; then
  echo "Commit stopped: the change looks like it contains a secret (key, private key or database password)."
  exit 1
fi
for f in $(git diff --cached --name-only --diff-filter=A); do
  case "$f" in .env|.env.*|*.pem|*.key|*.dump|*.dump.gpg|*.map|.DS_Store) [ "$f" = ".env.example" ] || { echo "Commit stopped: $f must not be committed."; exit 1; } ;; esac
done
exit 0
